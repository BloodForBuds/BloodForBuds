# Environment-variable reference for Infisical. This file is documentation,
# not a runtime configuration file. Use the staging Firebase app in development
# and staging, and the production Firebase app in production.

# Host port published by Caddy. Give staging a different port only when it
# shares a Docker host with production.
CADDY_HTTP_PORT=80

# Application PostGIS store.
APP_DB_NAME=bloodforbuds
APP_DB_USER=bloodforbuds
APP_DB_PASSWORD=change-me
APP_DB_SSLMODE=disable

# Key Postgres store.
KEY_DB_NAME=bloodforbuds_keys
KEY_DB_USER=bloodforbuds_keys
KEY_DB_PASSWORD=change-me
KEY_DB_SSLMODE=disable

# OpenBao credentials. Development uses the same value for its dev root token
# and Go client token. Staging and production do not use BAO_TOKEN; they use the
# static seal key for automatic unsealing. Supply values through Infisical.
BAO_DEV_ROOT_TOKEN_ID=
BAO_TOKEN=
# Must decode to exactly 32 bytes; for example: openssl rand -hex 32
OPENBAO_UNSEAL_KEY=

# Public Firebase Web App configuration. These values identify the Firebase
# app and are intentionally delivered to the browser.
FIREBASE_PROJECT_ID=bloodforbuds-staging
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=bloodforbuds-staging.firebaseapp.com

# Optional outside Google-managed infrastructure: base64-encode the Firebase
# Admin service-account JSON as one line. Leave empty when workload identity /
# Application Default Credentials are supplied by the deployment platform.
# Generate this value with: openssl base64 -A -in firebase-admin.json
FIREBASE_ADMIN_CREDENTIALS_BASE64=

# Firebase session policy. Production and staging should always use secure
# cookies because TLS terminates before traffic reaches Caddy.
AUTH_COOKIE_SECURE=true
AUTH_SESSION_DURATION=12h
AUTH_MAX_AGE=5m
