# Environment-variable reference for Infisical. This file is documentation,
# not a runtime configuration file. Use the staging Firebase app in development
# and staging, and the production Firebase app in production.

# Host port published by Caddy. Give staging a different port only when it
# shares a Docker host with production.
CADDY_HTTP_PORT=80

# Application PostGIS store.
APP_DB_NAME=bloodforbuds
APP_DB_USER=bloodforbuds
APP_DB_PASSWORD=change-me
APP_DB_SSLMODE=disable

# Key Postgres store.
KEY_DB_NAME=bloodforbuds_keys
KEY_DB_USER=bloodforbuds_keys
KEY_DB_PASSWORD=change-me
KEY_DB_SSLMODE=disable

# Staging/production backups. Create one bucket and independent Restic
# repository password for each target, provider, and environment. These are not
# used by compose.dev.yaml.
KEY_BACKUP_B2_REPOSITORY=b2:bloodforbuds-staging-key-store:restic
KEY_BACKUP_B2_ACCOUNT_ID=
KEY_BACKUP_B2_ACCOUNT_KEY=
KEY_BACKUP_B2_REPOSITORY_PASSWORD=
KEY_BACKUP_R2_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/bloodforbuds-staging-key-store/restic
KEY_BACKUP_R2_ACCESS_KEY_ID=
KEY_BACKUP_R2_SECRET_ACCESS_KEY=
KEY_BACKUP_R2_REPOSITORY_PASSWORD=

APP_BACKUP_B2_REPOSITORY=b2:bloodforbuds-staging-app-store:restic
APP_BACKUP_B2_ACCOUNT_ID=
APP_BACKUP_B2_ACCOUNT_KEY=
APP_BACKUP_B2_REPOSITORY_PASSWORD=
APP_BACKUP_R2_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/bloodforbuds-staging-app-store/restic
APP_BACKUP_R2_ACCESS_KEY_ID=
APP_BACKUP_R2_SECRET_ACCESS_KEY=
APP_BACKUP_R2_REPOSITORY_PASSWORD=

OPENBAO_BACKUP_B2_REPOSITORY=b2:bloodforbuds-staging-openbao:restic
OPENBAO_BACKUP_B2_ACCOUNT_ID=
OPENBAO_BACKUP_B2_ACCOUNT_KEY=
OPENBAO_BACKUP_B2_REPOSITORY_PASSWORD=
OPENBAO_BACKUP_R2_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/bloodforbuds-staging-openbao/restic
OPENBAO_BACKUP_R2_ACCESS_KEY_ID=
OPENBAO_BACKUP_R2_SECRET_ACCESS_KEY=
OPENBAO_BACKUP_R2_REPOSITORY_PASSWORD=

# OpenBao credentials. Development uses the same value for its dev root token
# and Go client token. Staging and production do not use BAO_TOKEN; they use the
# static seal key for automatic unsealing. Supply values through Infisical.
BAO_DEV_ROOT_TOKEN_ID=
BAO_TOKEN=
# Must decode to exactly 32 bytes; for example: openssl rand -hex 32
OPENBAO_UNSEAL_KEY=
# AppRole credentials used by the backup service to request a fresh 30-minute
# token before each OpenBao snapshot. Generate distinct random hex values for
# staging and production; for example: openssl rand -hex 32
BAO_BACKUP_ROLE_ID=
BAO_BACKUP_SECRET_ID=
# Break-glass AppRole credentials used by operators to request a fresh
# 15-minute administrative token. OpenBao consumes them during self-
# initialization and operators use them for later administration. Generate
# distinct values for each environment and do not expose them to app services.
BAO_OPERATOR_ROLE_ID=
BAO_OPERATOR_SECRET_ID=

# Public Firebase Web App configuration. These values identify the Firebase
# app and are intentionally delivered to the browser.
FIREBASE_PROJECT_ID=bloodforbuds-staging
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=bloodforbuds-staging.firebaseapp.com

# Optional outside Google-managed infrastructure: base64-encode the Firebase
# Admin service-account JSON as one line. Leave empty when workload identity /
# Application Default Credentials are supplied by the deployment platform.
# Generate this value with: openssl base64 -A -in firebase-admin.json
FIREBASE_ADMIN_CREDENTIALS_BASE64=

# Firebase session policy. Production and staging should always use secure
# cookies because TLS terminates before traffic reaches Caddy.
AUTH_COOKIE_SECURE=true
AUTH_SESSION_DURATION=12h
AUTH_MAX_AGE=5m
